# Backend environment configuration — copy to .env and customise
APP_NAME=PhishGuard
APP_VERSION=1.0.0
DEBUG=false

# CORS: restrict to your frontend origin in production
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./phishguard.db

# Path to the saved model artifact (relative to backend/)
MODEL_PATH=models/phishguard_model.joblib

# Enable or disable scan history persistence (true/false)
ENABLE_HISTORY=true

# Maximum URL length accepted by the API
MAX_URL_LENGTH=2048
